# UniFi controller (default: https://192.168.1.1)
UNIFI_HOST=https://192.168.1.1

# Pattern A — run with `op run --env-file .env -- docker compose up -d`
# (the op:// refs get resolved on the host; plain values land in the container)
UNIFI_USER=op://Private/UniFi - Personal/email
UNIFI_PASS=op://Private/UniFi - Personal/password
UNIFI_TOTP=op://Private/UniFi - Personal/TOTP_F3EC55A797B64934B598E0413015B0ED

# Pattern B — plain values (not recommended; prefer 1Password)
# UNIFI_USER=you@example.com
# UNIFI_PASS=secret
# UNIFI_TOTP=123456

# Whisper
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=tiny

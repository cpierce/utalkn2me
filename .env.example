# UniFi controller (default: https://192.168.1.1)
UNIFI_HOST=https://192.168.1.1

# Pattern A — run with `op run --env-file .env -- docker compose up -d`
# (the op:// refs get resolved on the host; plain values land in the container)
# Replace <vault>/<item>/<field> with your own 1Password paths.
UNIFI_USER=op://<vault>/<item>/username
UNIFI_PASS=op://<vault>/<item>/password
UNIFI_TOTP=op://<vault>/<item>/one-time password?attribute=otp

# Pattern B — plain values (not recommended; prefer 1Password)
# UNIFI_USER=you@example.com
# UNIFI_PASS=secret
# UNIFI_TOTP=123456

# Whisper — models: tiny | base | small | medium | large-v3
# large-v3 is pre-baked into the image by default (~1.5-2 GB RAM at int8)
WHISPER_BACKEND=faster-whisper
WHISPER_MODEL=large-v3

# Strip whisper's trailing hallucination loops ("Thank you. Thank you…",
# "So I'm going to go ahead and get started." x20, etc). 1=on, 0=raw.
TRANSCRIPT_CLEAN=1

# How many days of MP3 recordings to keep. Transcripts stay forever;
# just the audio is pruned. 0 disables pruning.
PRUNE_RECORDINGS_DAYS=30

# Webhook push — leave PUSH_URL empty to disable (local-only mode).
# Every call and transcript is POSTed as JSON to PUSH_URL with bearer auth.
# PUSH_URL=https://api.yourcompany.com/ingest/utalkn2me
# PUSH_TOKEN=op://Private/utalkn2me-webhook/secret
# PUSH_SITE_ID=home-office-01
PUSH_BATCH=10
PUSH_INTERVAL=5
PUSH_TIMEOUT=30

API_PORT=8000
